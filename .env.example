GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Sheet1!A:V
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SLACK_DESIGN_REQUEST_WEBHOOK_URL=
DESIGN_REQUEST_EMAIL_ENDPOINT=

# ES MCP / AI Images
ES_MCP_ENDPOINT=https://mcp.essentiallysports.com/mcp
ES_MCP_ISSUER=https://mcp.essentiallysports.com
ES_MCP_SEARCH_TOOL=search_images
ES_MCP_PROTOCOL_VERSION=2025-06-18
ES_IMAGE_BUCKET=essentiallysports-images-v2prod

# Pick one ES MCP token mode.
# Short-lived access token mode:
ES_MCP_ACCESS_TOKEN=

# Refresh-token mode:
ES_MCP_CLIENT_ID=
ES_MCP_REFRESH_TOKEN=
ES_MCP_TOKEN_ENDPOINT=

# Reels speech recognition fallback.
# Do not commit real API keys.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# FrameUp Generate (/api/es-generate). The AI that understands the brief:
# Groq (free tier) whenever GROQ_API_KEY is set (same key as Reels captions);
# OpenAI only if GENERATE_USE_OPENAI=true (billed); GENERATE_AI=rules turns AI off.
GENERATE_AI=
GROQ_GENERATE_MODEL=openai/gpt-oss-120b
GENERATE_USE_OPENAI=false
OPENAI_GENERATE_MODEL=gpt-4.1-mini
# Optional: pin ES MCP tool names instead of auto-discovery.
ES_MCP_THINK_TOOL=
ES_MCP_ARTICLES_TOOL=
ES_MCP_STATS_TOOL=
ES_MCP_TRENDING_TOOL=
