GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Sheet1!A:V
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SLACK_DESIGN_REQUEST_WEBHOOK_URL=
DESIGN_REQUEST_EMAIL_ENDPOINT=

# ES MCP / AI Images
ES_MCP_ENDPOINT=https://mcp.essentiallysports.com/mcp
ES_MCP_ISSUER=https://mcp.essentiallysports.com
ES_MCP_SEARCH_TOOL=search_images
ES_MCP_PROTOCOL_VERSION=2025-06-18
ES_IMAGE_BUCKET=essentiallysports-images-v2prod

# Pick one ES MCP token mode.
# Short-lived access token mode:
ES_MCP_ACCESS_TOKEN=

# Refresh-token mode:
ES_MCP_CLIENT_ID=
ES_MCP_REFRESH_TOKEN=
ES_MCP_TOKEN_ENDPOINT=

# Reels speech recognition fallback.
# Do not commit real API keys.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# FrameUp Generate (/api/es-generate). The AI that understands the brief:
# Groq (free tier) whenever GROQ_API_KEY is set (same key as Reels captions);
# OpenAI only if GENERATE_USE_OPENAI=true (billed); GENERATE_AI=rules turns AI off.
GENERATE_AI=
GROQ_GENERATE_MODEL=openai/gpt-oss-120b
GENERATE_USE_OPENAI=false
OPENAI_GENERATE_MODEL=gpt-4.1-mini
# Optional: pin ES MCP tool names instead of auto-discovery.
ES_MCP_THINK_TOOL=
ES_MCP_ARTICLES_TOOL=
ES_MCP_STATS_TOOL=
ES_MCP_TRENDING_TOOL=

# Impact stats pull (/api/impact-stats, admins only). Groundwork: with no key
# the Dashboard says "not connected" and admins use the CSV import instead.
# Server env only; never sent to the browser.
#   BEEHIIV_API_KEY: Beehiiv API key (Settings > Integrations > API), read-only use.
#   META_ACCESS_TOKEN: Meta Marketing API token from a Business Manager system
#     user with ads_read. META_AD_ACCOUNT_ID: the act_... account to read.
BEEHIIV_API_KEY=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Editor "Remove background" (/api/remove-bg). Works with the OPENAI_API_KEY
# above (same key as Reels transcription); nothing new needed. The model's
# output is used only as a mask on the original photo, never shown.
# Provider: openai (default, direct) | gateway (AI_GATEWAY_API_KEY, Gateway's
# /v1/images/edits; switch on after one real check) | bria (BRIA_API_KEY).
# Admins can check a deployment with GET /api/remove-bg?diag=1 (booleans only).
REMOVE_BG_PROVIDER=openai
# Extra people allowed to see ?diag=1 besides dashboard admins (comma-separated).
REMOVE_BG_DIAG_EMAILS=
REMOVE_BG_MODEL=gpt-image-1-mini
# low ≈ $0.005 per image, medium ≈ $0.011 (gpt-image-1-mini); real cost is logged from usage.
REMOVE_BG_QUALITY=low
REMOVE_BG_HOURLY_LIMIT=30
# Optional Bria provider only:
BRIA_API_KEY=
BRIA_REMOVE_BG_URL=
REMOVE_BG_COST_USD=0.018
# ── AI on the Vercel AI Gateway (one key for every AI job) ─────────────────
# Do not commit real keys. See project-docs/ai-strategy-and-costs.md ("Every AI
# environment variable") for what each one does.
AI_GATEWAY_API_KEY=
# Tier models (defaults shown).
AI_LIGHT_MODEL=openai/gpt-oss-20b
AI_MAIN_MODEL=anthropic/claude-haiku-5.5
AI_SEARCH_MODEL=anthropic/claude-haiku-5.5
AI_REVIEW_MODEL=openai/gpt-6-luna
AI_BEST_MODEL=anthropic/claude-sonnet-5.5
AI_IMAGE_MODEL=bfl/flux-3-image-klein
# Backup text model on the Gateway, used when GROQ_API_KEY is not set.
AI_BACKUP_MODEL=openai/gpt-oss-120b
# Reels captions on the Gateway (word timestamps). Order without REELS_TRANSCRIBE:
# Groq (free) -> Gateway -> direct OpenAI. REELS_TRANSCRIBE=gateway|groq|openai moves one first.
AI_TRANSCRIPTION_MODEL=elevenlabs/scribe-v2
REELS_TRANSCRIBE=
# Caps (USD per week, Monday 00:00 UTC). $20/person is a testing value; raise freely.
AI_USER_WEEKLY_LIMIT_USD=20
AI_USER_HOURLY_LIMIT=120
AI_TEAM_WEEKLY_LIMIT_USD=
# 1 = block AI when spend can't be read (default: allow and log a warning).
AI_FAIL_CLOSED=
# Comma list of features to switch off, e.g. video-ads-find-clips,trend-enrich (or "all").
AI_DISABLE=
# 1 = run the Sonnet tier on Haiku.
AI_ECONOMY=
# Spend alerts (Slack) and the daily budget cron.
SLACK_AI_ALERTS_WEBHOOK_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Reels Studio (reel-maker.html). Voice, caption timing and music all go through
# the Vercel AI Gateway (AI_GATEWAY_API_KEY, already used by every AI feature);
# no ElevenLabs account is needed. With no Gateway key, reels export captions-only.
# REELS_TTS: unset = Gateway (default) | off = captions only | elevenlabs = direct ElevenLabs fallback.
REELS_TTS=
# Speech model on the Gateway. Default elevenlabs/eleven-v4 ($0.00008/char, the most human
# ElevenLabs model; falls back to eleven-multilingual-v2, then eleven-flash-v2.5, if it fails).
# Setting this pins one model (no fallback). Check it after a deploy: GET /api/reel-maker?diag=voice (admins).
REELS_TTS_MODEL=
# Default voice when the editor has not picked one of the four (Brian, Liam, Sarah, Bella).
# Default: ElevenLabs "Brian" (nPczCjzI2devNBz1zQrb), a public library voice.
# Never a cloned voice: other ElevenLabs ids must be library voices, or are checked with
# ELEVENLABS_API_KEY and refused if cloned. Google default Charon, OpenAI default onyx.
REELS_TTS_VOICE=
# Word timings for captions (the speech reply has none): Gateway transcription.
REELS_ALIGN_MODEL=elevenlabs/scribe-v2
# Generated instrumental bed with elevenlabs/music-v2.5 ($0.0025/s). Off unless "gateway".
# Recorded as organic-only (ElevenLabs music terms don't name paid ads), so paid exports block.
REELS_MUSIC=
# AI b-roll clips for scene beats with no real clip (stadium, crowd, field; never people or
# logos). Off unless "gateway". google/veo-3.1-lite-generate-001, 4 s at 720p, $0.12 a clip.
REELS_AI_CLIPS=
# At most this many AI clips per reel (default 2).
REELS_AI_CLIPS_MAX=2
# Optional: another Gateway video model id.
REELS_AI_CLIP_MODEL=
# Reels Studio clip picker: the vision model that rates sampled clip frames (default google/gemini-3.8-flash,
# Claude Haiku 5.5 when it fails). Capped at $0.10 per reel, logged as reels-clip-judge.
REELS_CLIP_JUDGE_MODEL=
# Optional direct-ElevenLabs fallback (REELS_TTS=elevenlabs) and the never-clone check.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
