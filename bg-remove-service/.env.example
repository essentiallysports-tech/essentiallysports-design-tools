# Copy this file to .env and adjust as needed for your machine.

# Max upload size accepted by POST /api/remove-background, in bytes.
MAX_UPLOAD_BYTES=10485760

# Comma-separated list of origins allowed to call this service (CORS).
# Add whatever localhost origin you serve FrameUp's index.html from.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
